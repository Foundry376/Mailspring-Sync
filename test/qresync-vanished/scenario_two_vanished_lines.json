{
  "note": "Two separate messages are expunged at different moments during a single IDLE, producing two untagged '* VANISHED' lines. mailsync's IDLE harvester breaks after the first extension entry, so the second is dropped.",
  "idle_seconds": 3,
  "suppress_after_report": true,
  "mailboxes": [
    {
      "name": "INBOX",
      "attrs": [
        "\\HasNoChildren"
      ],
      "messages": 200
    },
    {
      "name": "Archive",
      "attrs": [
        "\\HasNoChildren",
        "\\Archive"
      ],
      "messages": 0
    },
    {
      "name": "Sent",
      "attrs": [
        "\\HasNoChildren",
        "\\Sent"
      ],
      "messages": 0
    },
    {
      "name": "Trash",
      "attrs": [
        "\\HasNoChildren",
        "\\Trash"
      ],
      "messages": 0
    }
  ],
  "events": [
    {
      "when": "during_idle",
      "do": "expunge",
      "mailbox": "INBOX",
      "uids": [
        10
      ],
      "announce_here": true,
      "delay": 14,
      "once": true
    },
    {
      "when": "during_idle",
      "do": "expunge",
      "mailbox": "INBOX",
      "uids": [
        11
      ],
      "announce_here": true,
      "delay": 14,
      "once": true
    }
  ]
}